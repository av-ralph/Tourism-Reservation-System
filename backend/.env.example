# Select tidb after copying the connection string from TiDB Cloud Connect > Prisma.
HM_STORAGE=file
DATABASE_URL="mysql://USERNAME:PASSWORD@HOST:4000/DATABASE?sslaccept=strict"
# If the Connect dialog supplies a CA certificate, append &sslcert=C:/path/to/ca.pem
PORT=3001
# Optional: set the temporary admin access key here; otherwise the local key file is used.
HM_ADMIN_KEY=
# Optional booking-status emails from a Gmail account with 2-Step Verification.
# Create a Google App Password; never use the regular account password here.
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
